# Más adelante Laravel podrá usar esta variable.
# Por ahora el frontend funciona con datos locales/mock.
VITE_API_URL=http://127.0.0.1:8000/api

# WhatsApp de la persona encargada de PQR en SkyedSocial.
# Formato: código de país + número, sin +, espacios ni guiones.
# Ejemplo Colombia (Sogamoso): 573001234567
VITE_WHATSAPP_PQR=573000000000
