# Más adelante Laravel podrá usar esta variable.
# Por ahora el frontend funciona con datos locales/mock.
VITE_API_URL=http://127.0.0.1:8000/api

# WhatsApp de la persona encargada de PQR en SkyedSocial.
# Formato: código de país + número, sin +, espacios ni guiones.
# Ejemplo Colombia (Sogamoso): 573001234567
VITE_WHATSAPP_PQR=573000000000

# Cuentas de SKYED para pagar la inscripción deportiva (se muestran en la
# página de pago y con ellas se revisa que el comprobante sea un pago a SKYED).
# Si no se ponen, se usan los datos de ejemplo. Para probar con una captura
# de Nequi, pon aquí el número y el nombre que aparecen en esa captura.
# VITE_PAGO_NEQUI=3001234567
# VITE_PAGO_TITULAR=SKYED Eventos SAS
# VITE_PAGO_BANCO=Bancolombia
# VITE_PAGO_TIPO_CUENTA=Cuenta de ahorros
# VITE_PAGO_CUENTA=123-456789-12
# VITE_PAGO_NIT=900.123.456-7
